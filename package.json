{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "cross-env NEXT_PUBLIC_BLOG_DATA_MODE=mock npm run build && cross-env NEXT_PUBLIC_BLOG_DATA_MODE=mock playwright test --grep-invert @live",
    "test:e2e:live": "cross-env NEXT_PUBLIC_BLOG_DATA_MODE=live npm run build && cross-env PLAYWRIGHT_LIVE=1 NEXT_PUBLIC_BLOG_DATA_MODE=live playwright test --grep @live"
  },
